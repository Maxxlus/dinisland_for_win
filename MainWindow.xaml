<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="220" Height="48" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" AllowDrop="True" DragEnter="Win_DragEnter" DragOver="Win_DragOver" DragLeave="Win_DragLeave" Drop="Win_Drop" UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="Fg" Color="White"/>
    <SolidColorBrush x:Key="Sub" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Panel" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="ArtColor" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Field" Color="Black"/>
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageBtn" TargetType="RepeatButton">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="8" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="{DynamicResource Sub}" CornerRadius="3" Margin="2,0" Opacity="0.45"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.9"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,10">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Box" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Card}" BorderThickness="1.5" CornerRadius="10">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Sub}" Margin="{TemplateBinding Padding}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" FontSize="{TemplateBinding FontSize}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" MinHeight="30">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource Field}"
                      BorderBrush="{DynamicResource Card}" BorderThickness="1.5" VerticalAlignment="Center" Margin="10,0,0,0">
                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SecTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Margin" Value="6,0,0,5"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Island" Width="200" Height="40" CornerRadius="20" Background="Black"
          HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True"
          MouseEnter="Island_Enter" AllowDrop="True">
    <Grid>
      <!-- Свернутый вид -->
      <Grid x:Name="Mini" Height="40" VerticalAlignment="Top">
        <TextBlock x:Name="ClockMini" Foreground="{DynamicResource Fg}" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0">
          <TextBlock x:Name="TimerMini" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ArtColor}" Visibility="Collapsed" Margin="0,0,4,0"/>
          <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="2,0" Visibility="Collapsed"/>
          <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="2,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
          <Border x:Name="MiniArt" Width="20" Height="20" CornerRadius="6" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Grid>
            <StackPanel x:Name="Bars" Orientation="Horizontal" Height="14" Visibility="Collapsed"/>
            <TextBlock x:Name="PauseIcon" FontFamily="{StaticResource Icons}" Text="&#xE769;" FontSize="13"
                       Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>
          </Grid>
        </StackPanel>
      </Grid>

      <!-- Пик -->
      <Grid x:Name="PeekBox" Width="330" Height="56" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="PkArt" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Card}" Margin="0,0,10,0">
            <TextBlock x:Name="PkGlyph" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Fg}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="PkL1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PkL2" FontSize="11" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="PkProg" Height="4" Margin="0,3,0,0" Visibility="Collapsed">
              <Border CornerRadius="2" Background="{DynamicResource Card}"/>
              <Border x:Name="PkFill" CornerRadius="2" Background="{DynamicResource Fg}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="PkRight" Grid.Column="2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Grid>

      <!-- Развернутый вид -->
      <Grid x:Name="Full" Width="440" Height="230" HorizontalAlignment="Center" VerticalAlignment="Top"
            Opacity="0" IsHitTestVisible="False" AllowDrop="True">
        <Border x:Name="Glow" IsHitTestVisible="False"/>
        <Grid Margin="16,10,16,14">
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel x:Name="BatBox" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="BatText" FontSize="11" Foreground="{DynamicResource Sub}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <Grid Width="22" Height="11" VerticalAlignment="Center">
                  <Border CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Sub}" Margin="0,0,2,0"/>
                  <Border x:Name="BatFill" CornerRadius="1.5" Background="{DynamicResource Fg}" HorizontalAlignment="Left" Margin="2,2,0,2" Width="0"/>
                  <Border Width="2" Height="4" CornerRadius="1" Background="{DynamicResource Sub}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="BatBolt" Text="&#x26A1;" FontFamily="Segoe UI Symbol" FontSize="11" Foreground="{DynamicResource ArtColor}"
                           Margin="3,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="ClockBig" Foreground="{DynamicResource Fg}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                         Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Clock_Click"/>
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource Sub}"
                         VerticalAlignment="Center" Margin="4,0,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Clock_Click"/>
            </StackPanel>
            <Grid>
              <Border x:Name="TabPill" Width="34" Height="28" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource Card}"/>
              <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Flat}" Tag="0" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE8D6;"/>
              <Button Style="{StaticResource Flat}" Tag="1" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE77F;" Margin="3,0,0,0"/>
              <Button Style="{StaticResource Flat}" Tag="2" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE8BD;" Margin="3,0,0,0"/>
              <Button Style="{StaticResource Flat}" Tag="3" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE916;" Margin="3,0,0,0"/>
              <Button Style="{StaticResource Flat}" Tag="4" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE8B7;" Margin="3,0,0,0"/>
              <Button Style="{StaticResource Flat}" Tag="5" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE787;" Margin="3,0,0,0"/>
              <Button Style="{StaticResource Flat}" Tag="6" Click="Tab_Click" Width="34" Height="28" FontFamily="{StaticResource Icons}" Content="&#xE713;" Margin="3,0,0,0"/>
              </StackPanel>
              </Grid>
          </DockPanel>

          <Grid Grid.Row="1">
            <!-- Медиа -->
            <Grid x:Name="P0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="120" Height="120" CornerRadius="16" Background="{DynamicResource Card}" Margin="0,0,16,0" VerticalAlignment="Center">
                <Grid>
                  <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="36" Foreground="{DynamicResource Sub}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border x:Name="Art" CornerRadius="16" Background="Transparent" Cursor="Hand" ToolTip="Двойной клик — текст песни" MouseLeftButtonUp="Art_Click"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Ничего не играет" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,10,0,0" Height="30">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="VolIcon" Style="{StaticResource Flat}" Click="Mute_Click" MouseEnter="VolBtn_Enter" MouseWheel="Vol_Wheel" Width="30" Height="30" FontSize="14" FontFamily="{StaticResource Icons}" Content="&#xE767;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                    <Grid x:Name="SeekTrack" Height="14" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up">
                      <Border Height="4" CornerRadius="2" Background="{DynamicResource Card}"/>
                      <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{DynamicResource Fg}" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <Grid>
                      <TextBlock x:Name="TimeL" FontSize="10" Foreground="{DynamicResource Sub}" HorizontalAlignment="Left"/>
                      <TextBlock x:Name="TimeR" FontSize="10" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Flat}" Click="Dislike_Click" Width="30" Height="30" FontSize="14" FontFamily="{StaticResource Icons}" Content="&#xE19E;"/>
                  <Button x:Name="LikeBtn" Grid.Column="3" Style="{StaticResource Flat}" Click="Like_Click" Width="30" Height="30" FontSize="17" FontFamily="Segoe UI Symbol" Content="&#x2661;"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                  <Button Style="{StaticResource Flat}" Click="Prev_Click" Width="52" Height="42" FontSize="20" FontFamily="{StaticResource Icons}" Content="&#xE892;"/>
                  <Button Style="{StaticResource Flat}" Click="Play_Click" Width="52" Height="42" FontSize="24" FontFamily="{StaticResource Icons}" x:Name="PlayIcon" Content="&#xE768;"/>
                  <Button Style="{StaticResource Flat}" Click="Next_Click" Width="52" Height="42" FontSize="20" FontFamily="{StaticResource Icons}" Content="&#xE893;"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Буфер обмена -->
            <ScrollViewer x:Name="P1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="ClipList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Flat}" Click="Clip_Click" MouseRightButtonUp="Clip_Remove" ToolTip="Правая кнопка — удалить" Tag="{Binding}" Background="{DynamicResource Card}"
                            HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,4">
                      <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- ИИ-чат -->
            <Grid x:Name="P2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ChatList"/></ScrollViewer>
              <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="14" Margin="0,6,0,0">
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                         CaretBrush="{DynamicResource Fg}" Padding="12,8" FontSize="13" KeyDown="Input_KeyDown"/>
              </Border>
            </Grid>

            <!-- Таймер -->
            <Grid x:Name="P3" Visibility="Collapsed">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TimerBig" Text="05:00" FontSize="46" FontWeight="Light" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                <Grid x:Name="TProg" Height="4" Width="260" Margin="0,0,0,10">
                  <Border CornerRadius="2" Background="{DynamicResource Card}"/>
                  <Border x:Name="TFill" CornerRadius="2" Background="{DynamicResource ArtColor}" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Style="{StaticResource Flat}" Tag="m1" Click="TMode_Click" Background="{DynamicResource Card}" Padding="10,4" Margin="0,0,6,0" FontSize="12" Content="1 мин"/>
                  <Button Style="{StaticResource Flat}" Tag="m5" Click="TMode_Click" Background="{DynamicResource Card}" Padding="10,4" Margin="0,0,6,0" FontSize="12" Content="5 мин"/>
                  <Button Style="{StaticResource Flat}" Tag="m10" Click="TMode_Click" Background="{DynamicResource Card}" Padding="10,4" Margin="0,0,6,0" FontSize="12" Content="10 мин"/>
                  <Button Style="{StaticResource Flat}" Tag="m25" Click="TMode_Click" Background="{DynamicResource Card}" Padding="10,4" Margin="0,0,6,0" FontSize="12" Content="25 мин"/>
                  <Button Style="{StaticResource Flat}" Tag="sw" Click="TMode_Click" Background="{DynamicResource Card}" Padding="10,4" FontSize="12" Content="Секундомер"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <Button Style="{StaticResource Flat}" Click="TReset_Click" Background="{DynamicResource Card}" Width="44" Height="36" FontSize="15" FontFamily="{StaticResource Icons}" Content="&#xE72C;" Margin="0,0,10,0"/>
                  <Button x:Name="TStart" Style="{StaticResource Flat}" Click="TStart_Click" Background="{DynamicResource Accent}" Foreground="White" Width="64" Height="36" FontSize="18" FontFamily="{StaticResource Icons}" Content="&#xE768;"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Файлы -->
            <Grid x:Name="P4" Visibility="Collapsed" AllowDrop="True">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ShelfList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Flat}" Tag="{Binding FullPath}" Background="{DynamicResource Card}" HorizontalContentAlignment="Left"
                              Padding="10,6" Margin="0,0,0,4" Click="Shelf_Click" PreviewMouseLeftButtonDown="Shelf_Down"
                              PreviewMouseMove="Shelf_Move" MouseRightButtonUp="Shelf_Remove">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8A5;" Margin="0,0,8,0" Foreground="{DynamicResource Sub}"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="ShelfHint" Text="Перетащите файлы на остров — они задержатся здесь.&#x0A;Потом перетащите их дальше или нажмите, чтобы открыть.&#x0A;Правый клик — убрать из списка."
                         TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Sub}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Календарь и погода -->
            <Grid x:Name="P5" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="CalNext_Click" Width="24" Height="22" FontSize="11" FontFamily="{StaticResource Icons}" Content="&#xE76C;"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="CalPrev_Click" Width="24" Height="22" FontSize="11" FontFamily="{StaticResource Icons}" Content="&#xE76B;"/>
                  <TextBlock x:Name="CalTitle" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid x:Name="CalGrid" Columns="7" Height="142"/>
              </StackPanel>
              <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="14" Background="{DynamicResource Card}" Padding="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="WxIcon" FontSize="32" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" Foreground="{DynamicResource Fg}"/>
                  <TextBlock x:Name="WxTemp" FontSize="26" FontWeight="Light" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="WxDesc" FontSize="11" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" TextAlignment="Center"/>
                  <TextBlock x:Name="WxCity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Темы и настройки -->
            <ScrollViewer x:Name="P6" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Style="{StaticResource SecTitle}" Text="ИИ · OPENROUTER"/>
                <Border Style="{StaticResource CardBox}">
                  <StackPanel>
                    <TextBox x:Name="KeyBox" Style="{StaticResource Box}" Tag="API-ключ  (sk-or-…)" TextChanged="Settings_Changed"/>
                    <TextBox x:Name="ModelBox" Style="{StaticResource Box}" Tag="Модель  (openai/gpt-4o-mini)" Margin="0,6,0,0" TextChanged="Settings_Changed"/>
                    <CheckBox x:Name="DirectChk" Style="{StaticResource Switch}" Margin="0,6,0,0" Click="Direct_Click">
                      <StackPanel>
                        <TextBlock Text="Без прокси"/>
                        <TextBlock Text="Если чат пишет «ошибка подключения»" FontSize="10" Opacity="0.6"/>
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SecTitle}" Text="ОСТРОВ"/>
                <Border Style="{StaticResource CardBox}">
                  <StackPanel>
                    <CheckBox x:Name="StaticChk" Style="{StaticResource Switch}" Click="Static_Click">
                      <StackPanel>
                        <TextBlock Text="Статичность"/>
                        <TextBlock Text="По центру экрана, без перетаскивания" FontSize="10" Opacity="0.6"/>
                      </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="PeekChk" Style="{StaticResource Switch}" Content="Всплывающие уведомления" Margin="0,4,0,0" Click="PeekChk_Click"/>
                    <CheckBox x:Name="AutoChk" Style="{StaticResource Switch}" Content="Автозапуск с Windows" Margin="0,4,0,0" Click="AutoChk_Click"/>
                  </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SecTitle}" Text="ПОГОДА"/>
                <Border Style="{StaticResource CardBox}">
                  <TextBox x:Name="CityBox" Style="{StaticResource Box}" Tag="Город  (например, Heerlen)" TextChanged="Settings_Changed"/>
                </Border>

                <TextBlock Style="{StaticResource SecTitle}" Text="VPN-КЛИЕНТ ДЛЯ КНОПКИ В ШТОРКЕ"/>
                <Border Style="{StaticResource CardBox}">
                  <StackPanel x:Name="VpnChips" Orientation="Horizontal"/>
                </Border>

                <TextBlock Style="{StaticResource SecTitle}" Text="ПРИКОЛЬНОЕ"/>
                <Border Style="{StaticResource CardBox}">
                  <StackPanel>
                    <CheckBox x:Name="CafChk" Style="{StaticResource Switch}" Click="Caf_Click">
                      <StackPanel>
                        <TextBlock Text="Кофеин ☕"/>
                        <TextBlock Text="Экран и компьютер не засыпают" FontSize="10" Opacity="0.6"/>
                      </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="HourChk" Style="{StaticResource Switch}" Content="Сообщать о каждом часе" Margin="0,4,0,0" Click="Hour_Click"/>
                    <CheckBox x:Name="EyeChk" Style="{StaticResource Switch}" Margin="0,4,0,0" Click="Eye_Click">
                      <StackPanel>
                        <TextBlock Text="Перерыв для глаз"/>
                        <TextBlock Text="Напоминание каждые 20 минут" FontSize="10" Opacity="0.6"/>
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SecTitle}" Text="ТЕМЫ  ·  правая кнопка — удалить"/>
                <Border Style="{StaticResource CardBox}">
                  <WrapPanel x:Name="ThemesPanel"/>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
        <!-- Выпадающая громкость -->
        <Border x:Name="VolPop" Visibility="Collapsed" Width="40" Height="104" CornerRadius="20" Background="{DynamicResource Panel}"
                HorizontalAlignment="Left" VerticalAlignment="Top" MouseWheel="Vol_Wheel">
          <Grid x:Name="VolV" Margin="0,14" Background="Transparent" Cursor="Hand"
                MouseLeftButtonDown="Vol_Down" MouseMove="Vol_Move" MouseLeftButtonUp="Vol_Up">
            <Border Width="5" CornerRadius="2.5" Background="{DynamicResource Card}"/>
            <Border x:Name="VolFill" Width="5" CornerRadius="2.5" Background="{DynamicResource Fg}" VerticalAlignment="Bottom" Height="0"/>
          </Grid>
        </Border>
      </Grid>
      <!-- Шторка -->
      <Grid x:Name="Shade" Width="440" Height="204" Margin="0,230,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
            Opacity="0" IsHitTestVisible="False" AllowDrop="True">
        <Grid Margin="16,0,16,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="70"/><RowDefinition Height="8"/><RowDefinition Height="70"/><RowDefinition Height="8"/>
            <RowDefinition Height="30"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="-4,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="VpnTile" Style="{StaticResource Tile}" Click="VpnTile_Click" MouseRightButtonUp="VpnTile_Right" Margin="4,0">
              <Grid>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE774;" FontSize="18" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="VPN" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="VpnSub" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="ThemeTile" Grid.Column="1" Style="{StaticResource Tile}" Click="ThemeTile_Click" Margin="4,0">
              <Grid>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE706;" FontSize="18" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="Тема" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ThemeSub" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="FocusTile" Grid.Column="2" Style="{StaticResource Tile}" Click="FocusTile_Click" Margin="4,0">
              <Grid>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE708;" FontSize="18" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="Фокус" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="FocusSub" FontSize="10" Opacity="0.7"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="MuteTile" Grid.Column="3" Style="{StaticResource Tile}" Click="MuteTile_Click" Margin="4,0">
              <Grid>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="18" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="Звук" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="MuteSub" FontSize="10" Opacity="0.7"/>
                </StackPanel>
              </Grid>
            </Button>
          </Grid>

          <Grid Grid.Row="2" Margin="-4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Margin="4,0" CornerRadius="18" Background="{DynamicResource Card}" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="ShArt" Width="48" Height="48" CornerRadius="10" Background="{DynamicResource Card}" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="ShTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ShArtist" FontSize="11" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="ShPlay" Grid.Column="2" Style="{StaticResource Flat}" Click="ShPlay_Click" Width="34" Height="34"
                        FontFamily="{StaticResource Icons}" FontSize="16" Content="&#xE768;"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Margin="4,0" CornerRadius="18" Background="{DynamicResource Card}" Padding="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ShWx" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Text="—"/>
                <TextBlock Text="Погода" FontSize="10" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource Tile}" Click="TimerTile_Click" Margin="4,0">
              <Grid>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE916;" FontSize="18" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="Таймер" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ShTimer" FontSize="10" Opacity="0.7"/>
                </StackPanel>
              </Grid>
            </Button>
          </Grid>

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="15" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="2,0,10,0"/>
            <Grid x:Name="ShVolTrack" Grid.Column="1" Height="30" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Sh_Vol_Down" MouseMove="Sh_Vol_Move" MouseLeftButtonUp="Sh_Vol_Up">
              <Border Height="10" CornerRadius="5" Background="{DynamicResource Card}"/>
              <Border x:Name="ShVolFill" Height="10" CornerRadius="5" Background="{DynamicResource Fg}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </Grid>

          <Grid Grid.Row="5" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Grabber_Click">
            <Border Width="40" Height="5" CornerRadius="2.5" Background="{DynamicResource Sub}" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
